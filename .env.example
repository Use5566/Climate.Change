# Set on Render; this file is documentation and is not auto-loaded.
GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/google-service-account.json
COOKIE_SECURE=true
# C learning history defaults to Google Sheets; no disk is needed.
LEARNING_STORAGE=google_sheets
# Fill these privately in Render Environment Variables. Never commit a real key.
GEMINI_API_KEY=
# Model ID only, without models/. Choose a model available to your account.
GEMINI_MODEL=
# Enable only after the private UTF-8 teaching material has been provisioned.
# GEMINI_KNOWLEDGE_MODE=explicit
# GEMINI_KNOWLEDGE_PATH=/etc/secrets/science-knowledge.txt
# GEMINI_CACHE_TTL_SECONDS=3600
# Optional legacy SQLite storage: LEARNING_STORAGE=sqlite
# With SQLite on Render, also provision a disk and set LEARNING_DB_PATH.
# Alternative: GOOGLE_SERVICE_ACCOUNT_JSON may contain the full JSON in a secret environment variable.
